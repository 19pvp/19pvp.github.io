{
  "tasks": {
    "dev": "deno run --watch --unstable-raw-imports -A main.ts",
    "compile:linux": "deno compile --target x86_64-unknown-linux-gnu --unstable-raw-imports -A -o 19pvp-launcher-linux main.ts",
    "compile:win": "deno compile --target x86_64-pc-windows-msvc --self-extracting --unstable-raw-imports -A -o 19pvp-launcher-win.exe main.ts",
    "compile": {
      "dependencies": ["compile:linux", "compile:win"]
    },
    "test": "deno test -A --unstable-raw-imports"
  },
  "nodeModulesDir": "none",
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "semiColons": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "webtorrent": "./vendor/webtorrent/index.js"
  }
}
