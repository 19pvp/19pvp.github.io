+            case SPELL_AURA_PERIODIC_HEALTH_FUNNEL:
+            case SPELL_AURA_PERIODIC_DUMMY:
+                hasPeriodicDamageAura = true;
+                break;
+            default:
+                break;
+        }
+    }
+
+    // Apply school resistance to negative magic aura durations, except DoTs
+    // and channeled spells. Entangling Roots is both a DoT and a root, so its
+    // duration is resisted as well.
+    bool isEntanglingRoots = spellProto->SpellFamilyName == SPELLFAMILY_DRUID &&
+        spellProto->HasAura(SPELL_AURA_MOD_ROOT);
+    if ((!hasPeriodicDamageAura || isEntanglingRoots) && !spellProto->IsChanneled() && !positive && duration > 0 &&
+        !(spellProto->GetSchoolMask() & SPELL_SCHOOL_MASK_NORMAL) &&
+        (!(spellProto->GetSchoolMask() & SPELL_SCHOOL_MASK_HOLY) || target->IsCreature()))
+    {
+        float resist = GetEffectiveResistChance(this, spellProto->GetSchoolMask(), target, spellProto);
+        duration = std::max(1, int32(float(duration) * (1.0f - resist)));
+    }
+
     return std::max(duration, 0);
 }
 
