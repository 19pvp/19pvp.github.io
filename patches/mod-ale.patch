+    /**
+     * Invites the player to a battleground on a specific team.
+     * Sends the "Enter Battle" popup and sets up proper queue invite tracking
+     * so the player can actually accept. The invite will auto-expire after
+     * INVITE_ACCEPT_WAIT_TIME milliseconds if not accepted.
+     *
+     * @param BattleGround bg The Battleground object
+     * @param uint32 teamId The team to place the player in (0 = Alliance, 1 = Horde)
+     * @return bool success
+     */
+    int InviteToBattleground(lua_State* L, Player* player)
+    {
+        Battleground* bg = ALE::CHECKOBJ<Battleground>(L, 2);
+        uint32 teamId = ALE::CHECKVAL<uint32>(L, 3);
+
+        if (!player || !bg || teamId >= PVP_TEAMS_COUNT)
+        {
+            ALE::Push(L, false);
+            return 1;
+        }
+
+        BattlegroundQueueTypeId bgQueueTypeId = BattlegroundMgr::BGQueueTypeId(bg->GetBgTypeID(), bg->GetArenaType());
+
+        // Player-level idempotency guard — must be checked BEFORE any state mutations.
+        // ginfo->IsInvitedToBGInstanceGUID is shared across the whole GroupQueueInfo, so using
+        // it would block every cross-faction group member after the first one is invited.
+        // IsInvitedForBattlegroundQueueType checks _BgBattlegroundQueueID[i].invitedToInstance
+        // which is per-player and correctly handles group members independently.
+        if (player->IsInvitedForBattlegroundQueueType(bgQueueTypeId))
+        {
+            ALE::Push(L, false);
+            return 1;
+        }
+
+        BattlegroundQueue& bgQueue = sBattlegroundMgr->GetBattlegroundQueue(bgQueueTypeId);
+        GroupQueueInfo* ginfo = bgQueue.DetachPlayerFromGroup(player->GetGUID(), (TeamId)teamId);
+        if (!ginfo)
+        {
+            ALE::Push(L, false);
+            return 1;
+        }
+
+        player->AddBattlegroundQueueId(bgQueueTypeId);
+        uint32 queueSlot = player->GetBattlegroundQueueIndex(bgQueueTypeId);
+        player->SetInviteForBattlegroundQueueType(bgQueueTypeId, bg->GetInstanceID());
+        bg->IncreaseInvitedCount((TeamId)teamId);
+
+        // Required so HandleBattleFieldPortOpcode accepts the "Enter Battle" click.
+        ginfo->IsInvitedToBGInstanceGUID = bg->GetInstanceID();
+        ginfo->RemoveInviteTime = GameTime::GetGameTimeMS().count() + INVITE_ACCEPT_WAIT_TIME;
+
+        BGQueueRemoveEvent* removeEvent = new BGQueueRemoveEvent(
+            player->GetGUID(),
+            ginfo->IsInvitedToBGInstanceGUID,
+            bg->GetBgTypeID(),
+            bgQueueTypeId,
+            ginfo->RemoveInviteTime
+        );
+        bgQueue.AddEvent(removeEvent, INVITE_ACCEPT_WAIT_TIME);
+
+        WorldPacket data;
+        sBattlegroundMgr->BuildBattlegroundStatusPacket(&data, bg, queueSlot, STATUS_WAIT_JOIN, INVITE_ACCEPT_WAIT_TIME, 0, bg->GetArenaType(), (TeamId)teamId);
+        player->GetSession()->SendPacket(&data);
+
+        ALE::Push(L, true);
+        return 1;
+    }
