+    /**
+     * Sends a message to a channel (or all channel instances) by channel name.
+     *
+     * @param string channelName : channel name (e.g. "General")
+     * @param string message : message text
+     * @param uint32 teamId : optional teamId (0 = Alliance, 1 = Horde, default: 2 = all)
+     * @param uint32 lang : optional language (default: LANG_UNIVERSAL)
+     * @param Player|string sender : optional Player object or sender name string
+     */
+    int SendChannelMessage(lua_State* L)
+    {
+        const char* channelName = ALE::CHECKVAL<const char*>(L, 1);
+        const char* message = ALE::CHECKVAL<const char*>(L, 2);
+        uint32 teamId = ALE::CHECKVAL<uint32>(L, 3, 2); // default neutral/both
+        uint32 lang = ALE::CHECKVAL<uint32>(L, 4, LANG_UNIVERSAL);
+        Player* senderPlayer = ALE::CHECKOBJ<Player>(L, 5, false);
+        uint32 accountId = senderPlayer ? 0 : ALE::CHECKVAL<uint32>(L, 5, 0);
+
+        if (!channelName || !message)
+            return 0;
+
+        auto sendToMgr = [&](ChannelMgr* mgr)
+        {
+            if (!mgr) return;
+            std::string search = channelName;
+            std::transform(search.begin(), search.end(), search.begin(), ::tolower);
+            for (auto const& [name, channel] : mgr->GetChannels())
+            {
+                if (!channel) continue;
+                std::string cname = channel->GetName();
+                std::string cnameLower = cname;
+                std::transform(cnameLower.begin(), cnameLower.end(), cnameLower.begin(), ::tolower);
+
+                if (cnameLower == search || cnameLower.rfind(search + " - ", 0) == 0 || cnameLower.find(search) != std::string::npos)
+                {
+                    WorldPacket data;
+                    ObjectGuid senderGuid = senderPlayer ? senderPlayer->GetGUID() : ObjectGuid::Empty;
+
+                    if (!senderGuid && accountId != 0)
+                    {
+                        QueryResult res = CharacterDatabase.Query("SELECT guid FROM characters WHERE account = {} ORDER BY logout_time DESC LIMIT 1", accountId);
+                        if (res)
+                            senderGuid = ObjectGuid::Create<HighGuid::Player>((*res)[0].Get<uint32>());
+                    }
+
+                    ChatHandler::BuildChatPacket(data, CHAT_MSG_CHANNEL, Language(lang), senderGuid, senderGuid, message, 0, "", "", 0, false, cname);
+                    channel->SendToAll(&data);
+                }
+            }
+        };
+
+        ChannelMgr* allianceMgr = ChannelMgr::forTeam(TEAM_ALLIANCE);
+        ChannelMgr* hordeMgr = ChannelMgr::forTeam(TEAM_HORDE);
+
+        if (teamId == TEAM_ALLIANCE || teamId == 2)
+            sendToMgr(allianceMgr);
+        if ((teamId == TEAM_HORDE || teamId == 2) && hordeMgr != allianceMgr)
+            sendToMgr(hordeMgr);
+
+        return 0;
+    }
